# --- Local development ---------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production (Render) --------------------------------------------------
# Leave everything below commented out / unset for local dev — the app
# falls back to SQLite + local media/ automatically.

# Neon Postgres connection string (Render > Environment, or Neon dashboard)
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/genet_dental?sslmode=require

# Cloudflare R2 (S3-compatible) — for doctor photos, gallery, video uploads
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=genet-dental-media
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://media.genetdentalclinic.ae
# Add the final frontend origins when deploying:
# DJANGO_CORS_ALLOWED_ORIGINS=https://genetdentalclinic.ae,https://www.genetdentalclinic.ae,https://<your-vercel-domain>
